[Unit]
Description=pardon daemon (clipboard translation)
# 仅排序/停止联动（After/PartOf），不是硬门槛：合成器缺席时 daemon 也能
# 启动——剪贴板监听退避自愈，合成器出现后自动恢复监听。
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.cargo/bin/pardond
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
